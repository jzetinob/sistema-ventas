            -txtTelefono: JTextField
            -tblClientes: JTable
            -btnGuardar: JButton
            -btnActualizar: JButton
            -btnEliminar: JButton
            -btnLimpiar: JButton
            +FrmClientes()
        }

        class FrmEmpleados {
            -empleadoController: EmpleadoController
            -txtCodigoEmpleado: JTextField
            -txtNit: JTextField
            -txtNombre: JTextField
            -txtTelefono: JTextField
            -txtPuesto: JTextField
            -tblEmpleados: JTable
            -btnGuardar: JButton
            -btnActualizar: JButton
            -btnEliminar: JButton
            -btnLimpiar: JButton
            +FrmEmpleados()
        }

        class FrmVistaPreviaFactura {
            -ticket: TicketFactura
            +FrmVistaPreviaFactura(parent: Component, ticket: TicketFactura)
        }

        class TicketFactura {
            <<implements Printable>>
            -factura: Factura
            +TicketFactura(factura: Factura)
            +print(graphics: Graphics, pageFormat: PageFormat, pageIndex: int): int
            +pintar(g2d: Graphics2D, ancho: int, alto: int): void
        }

        class CampoBusqueda {
            -popup: JPopupMenu
            -lista: JList~String~
            -datos: List~String~
            -onSeleccion: Consumer~String~
            +CampoBusqueda(datos: List~String~, onSeleccion: Consumer~String~)
            +setDatos(datos: List~String~): void
            +filtrar(texto: String): void
        }
    }

    %% ==================== RELACIONES ====================

    %% HERENCIA
    Persona <|-- Cliente : Herencia
    Persona <|-- Empleado : Herencia

    %% COMPOSICIÓN: Factura contiene FacturaDetalle (ciclo de vida dependiente)
    Factura *-- "1..*" FacturaDetalle : Composición

    %% ASOCIACIÓN: Un Cliente puede tener 0..* Facturas; cada Factura tiene 1 Cliente
    Factura "0..*" --> "1" Cliente : Asociación

    %% ASOCIACIÓN: Un Producto aparece en 0..* FacturaDetalle; cada detalle tiene 1 Producto
    FacturaDetalle "0..*" --> "1" Producto : Asociación

    %% REALIZACIÓN: DAO Implementaciones implementan interfaces
    FacturaDAOSQLite ..|> FacturaDAO : Realización
    ProductoDAOSQLite ..|> ProductoDAO : Realización
    ClienteDAOSQLite ..|> ClienteDAO : Realización
    EmpleadoDAOSQLite ..|> EmpleadoDAO : Realización

    %% ASOCIACIÓN: Controladores usan DAOs (a través de interfaces)
    FacturaController --> "1" FacturaDAO : Asociación
    FacturaController --> "1" ProductoDAO : Asociación
    FacturaController --> "1" ClienteDAO : Asociación
    ProductoController --> "1" ProductoDAO : Asociación
    ClienteController --> "1" ClienteDAO : Asociación
    EmpleadoController --> "1" EmpleadoDAO : Asociación

    %% ASOCIACIÓN: Vistas usan Controladores
    FrmFactura --> "1" FacturaController : Asociación
    FrmFactura --> "1" ProductoController : Asociación
    FrmFactura --> "1" ClienteController : Asociación
    FrmListaFacturas --> "1" FacturaController : Asociación
    FrmProductos --> "1" ProductoController : Asociación
    FrmClientes --> "1" ClienteController : Asociación
    FrmEmpleados --> "1" EmpleadoController : Asociación

    %% ASOCIACIÓN: FrmListaFacturas abre FrmDetalleFactura
    FrmListaFacturas --> FrmDetalleFactura : Asociación

    %% ASOCIACIÓN: FrmFactura usa TicketFactura para impresión
    FrmFactura --> TicketFactura : Asociación
    FrmVistaPreviaFactura --> TicketFactura : Asociación

    %% ASOCIACIÓN: FrmFactura usa CampoBusqueda (reutilizable)
    FrmFactura --> CampoBusqueda : Asociación

    %% AGREGACIÓN: MDI - FrmPrincipal contiene formularios como ventanas internas
    %% (JDesktopPane agrega JInternalFrame; las ventanas pueden abrirse/cerrarse por separado)
    FrmPrincipal o-- "0..*" FrmFactura : Agregación (MDI)
    FrmPrincipal o-- "0..*" FrmListaFacturas : Agregación (MDI)
    FrmPrincipal o-- "0..*" FrmProductos : Agregación (MDI)
    FrmPrincipal o-- "0..*" FrmClientes : Agregación (MDI)
    FrmPrincipal o-- "0..*" FrmEmpleados : Agregación (MDI)

    %% ASOCIACIÓN: DAOs usan ConexionBD (Singleton)
    FacturaDAOSQLite --> "1" ConexionBD : Asociación
    ProductoDAOSQLite --> "1" ConexionBD : Asociación
    ClienteDAOSQLite --> "1" ConexionBD : Asociación
    EmpleadoDAOSQLite --> "1" ConexionBD : Asociación
    MigradorDatos --> "1" ConexionBD : Asociación

