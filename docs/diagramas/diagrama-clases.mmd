---
title: Sistema de Ventas - Diagrama de clases (app de escritorio)
---
classDiagram
    direction TB

    %% Getters y setters omitidos. Nombres y firmas tomados del codigo compilado (javap).
    %% Notacion: + publico, - privado, # protegido, ~ paquete, $ estatico, * abstracto.

    %% ============================== MODELO ==============================
    namespace modelo {
        class Persona {
            <<abstract>>
            #id: int
            #nombre: String
            #nit: String
            #telefono: String
            +mostrarInformacion() String
        }
        class Cliente {
            -direccion: String
        }
        class Empleado {
            -codigoEmpleado: String
            -puesto: String
            +mostrarInformacion() String
        }
        class Proveedor {
            -direccion: String
            -correo: String
            +mostrarInformacion() String
        }
        class Categoria {
            -id: int
            -nombre: String
            -descripcion: String
            +toString() String
        }
        class Producto {
            -idProducto: int
            -codigo: String
            -nombre: String
            -precio: double
            -existencia: int
            -categoria: Categoria
            +hayExistencia(cantidad: int) boolean
        }
        class Factura {
            -idFactura: int
            -numeroFactura: String
            -fecha: LocalDate
            -cliente: Cliente
            -detalles: List~FacturaDetalle~
            -total: double
            +agregarDetalle(detalle: FacturaDetalle) void
            +agregarDetalle(nombreProducto: String, cantidad: int, precio: double) void
            +eliminarDetalle(index: int) void
            +calcularTotal() double
            +getDetallesFilas() Object[][]
        }
        class FacturaDetalle {
            -producto: Producto
            -cantidad: int
            -precioUnitario: double
            +calcularSubtotal() double
        }
        class Compra {
            -id: int
            -numeroCompra: String
            -fecha: LocalDate
            -proveedor: Proveedor
            -usuario: Usuario
            -detalles: List~CompraDetalle~
            -total: double
            +agregarDetalle(detalle: CompraDetalle) void
            +eliminarDetalle(index: int) void
            +calcularTotal() double
        }
        class CompraDetalle {
            -producto: Producto
            -cantidad: int
            -costoUnitario: double
            +calcularSubtotal() double
        }
        class Usuario {
            -id: int
            -usuario: String
            -nombre: String
            -claveHash: String
            -salt: String
            -rol: Rol
            -activo: boolean
            +esAdministrador() boolean
        }
        class Rol {
            <<enumeration>>
            ADMINISTRADOR
            VENDEDOR
        }
    }

    Persona <|-- Cliente
    Persona <|-- Empleado
    Persona <|-- Proveedor
    Factura "1" *-- "1..*" FacturaDetalle : se compone de
    Compra "1" *-- "1..*" CompraDetalle : se compone de
    Factura "0..*" --> "1" Cliente : a nombre de
    FacturaDetalle "0..*" --> "0..1" Producto : vende
    CompraDetalle "0..*" --> "1" Producto : compra
    Compra "0..*" --> "1" Proveedor : a
    Compra "0..*" --> "0..1" Usuario : registrada por
    Producto "0..*" --> "0..1" Categoria : pertenece a
    Usuario --> Rol

    %% ========================= ACCESO A DATOS (DAO) =========================
    namespace dao {
        class ClienteDAO {
            <<interface>>
            +guardar(c: Cliente) void
            +listar() List~Cliente~
            +actualizar(c: Cliente) void
            +eliminar(id: int) void
            +existeNit(nit: String) boolean
        }
        class EmpleadoDAO {
            <<interface>>
            +guardar(e: Empleado) void
            +listar() List~Empleado~
            +actualizar(e: Empleado) void
            +eliminar(id: int) void
            +existeCodigoEmpleado(codigo: String) boolean
        }
        class ProveedorDAO {
            <<interface>>
            +guardar(p: Proveedor) void
            +listar() List~Proveedor~
            +actualizar(p: Proveedor) void
            +eliminar(id: int) boolean
            +existeNit(nit: String) boolean
        }
        class CategoriaDAO {
            <<interface>>
            +guardar(c: Categoria) void
            +listar() List~Categoria~
            +actualizar(c: Categoria) void
            +eliminar(id: int) boolean
            +existeNombre(nombre: String) boolean
        }
        class ProductoDAO {
            <<interface>>
            +guardar(p: Producto) void
            +listar() List~Producto~
            +actualizar(p: Producto) void
            +eliminar(id: int) boolean
            +existeCodigo(codigo: String) boolean
        }
        class FacturaDAO {
            <<interface>>
            +guardar(f: Factura) boolean
            +listar() List~Factura~
            +actualizar(f: Factura) void
            +eliminar(id: int) void
            +eliminarConDetalles(id: int) void
            +obtenerSiguienteNumeroFactura() String
        }
        class CompraDAO {
            <<interface>>
            +guardar(c: Compra) boolean
            +listar() List~Compra~
            +anular(id: int) boolean
            +obtenerSiguienteNumeroCompra() String
            +ultimoCosto(productoId: int) Double
        }
        class UsuarioDAO {
            <<interface>>
            +guardar(u: Usuario) void
            +listar() List~Usuario~
            +actualizar(u: Usuario) void
            +cambiarClave(id: int, hash: String, salt: String) void
            +eliminar(id: int) void
            +buscarPorUsuario(usuario: String) Usuario
            +existeUsuario(usuario: String) boolean
            +contar() int
            +contarAdministradoresActivos() int
        }
        class ClienteDAOSQLite {
            <<Singleton>>
            +getInstancia()$ ClienteDAOSQLite
        }
        class EmpleadoDAOSQLite {
            <<Singleton>>
            +getInstancia()$ EmpleadoDAOSQLite
        }
        class ProveedorDAOSQLite {
            <<Singleton>>
            +getInstancia()$ ProveedorDAOSQLite
        }
        class CategoriaDAOSQLite {
            <<Singleton>>
            +getInstancia()$ CategoriaDAOSQLite
        }
        class ProductoDAOSQLite {
            <<Singleton>>
            +getInstancia()$ ProductoDAOSQLite
            -asignarCategoria(ps: PreparedStatement, indice: int, p: Producto) void
        }
        class FacturaDAOSQLite {
            <<Singleton>>
            +getInstancia()$ FacturaDAOSQLite
            -guardarDetalles(c: Connection, f: Factura) void
            -descontarExistencia(c: Connection, f: Factura) boolean
        }
        class CompraDAOSQLite {
            <<Singleton>>
            +getInstancia()$ CompraDAOSQLite
            -cargarDetalles(c: Compra) void
        }
        class UsuarioDAOSQLite {
            <<Singleton>>
            +getInstancia()$ UsuarioDAOSQLite
        }
        class ClienteDAOCsv {
            <<Singleton>>
        }
        class ProductoDAOCsv {
            <<Singleton>>
        }
        class FacturaDAOCsv {
            <<Singleton>>
        }
        class ConexionBD {
            <<Singleton>>
            -motor: Motor
            -conexion: Connection
            -errorConexion: String
            +getInstancia()$ ConexionBD
            +getConnection() Connection
            +getMotor() Motor
            +getErrorConexion() String
            +respaldar(destino: File) void
            -conectarPostgres(config: Properties) void
            -crearEsquemaPostgres() void
            ~crearTablas(c: Connection)$ void
        }
        class Motor {
            <<enumeration>>
            SQLITE
            POSTGRESQL
        }
        class CopiadorBD {
            ~TABLAS$: String[]
            +copiar(origen: Connection, destino: Connection)$ void
            ~importarSqliteSiVacia(postgres: Connection, archivo: File)$ void
        }
        class MigradorDatos {
            <<Singleton>>
            +migrarSiVacio(c: Connection) void
        }
    }

    ClienteDAOSQLite ..|> ClienteDAO
    ClienteDAOCsv ..|> ClienteDAO
    EmpleadoDAOSQLite ..|> EmpleadoDAO
    ProveedorDAOSQLite ..|> ProveedorDAO
    CategoriaDAOSQLite ..|> CategoriaDAO
    ProductoDAOSQLite ..|> ProductoDAO
    ProductoDAOCsv ..|> ProductoDAO
    FacturaDAOSQLite ..|> FacturaDAO
    FacturaDAOCsv ..|> FacturaDAO
    CompraDAOSQLite ..|> CompraDAO
    UsuarioDAOSQLite ..|> UsuarioDAO
    ConexionBD --> Motor
    ConexionBD ..> CopiadorBD : sube datos / respalda
    ConexionBD ..> MigradorDatos : importa CSV
    ClienteDAOSQLite ..> ConexionBD
    EmpleadoDAOSQLite ..> ConexionBD
    ProveedorDAOSQLite ..> ConexionBD
    CategoriaDAOSQLite ..> ConexionBD
    ProductoDAOSQLite ..> ConexionBD
    FacturaDAOSQLite ..> ConexionBD
    CompraDAOSQLite ..> ConexionBD
    UsuarioDAOSQLite ..> ConexionBD

    %% ====================== CONTROLADORES Y SEGURIDAD ======================
    namespace controlador {
        class ClienteController {
            +Guardar(c: Cliente) void
            +GetClientes() List~Cliente~
            +Actualizar(c: Cliente) void
            +Eliminar(id: int) void
            +ExisteNit(nit: String) boolean
        }
        class EmpleadoController {
            +Guardar(e: Empleado) void
            +GetEmpleados() List~Empleado~
            +Actualizar(e: Empleado) void
            +Eliminar(id: int) void
            +ExisteCodigoEmpleado(codigo: String) boolean
        }
        class ProveedorController {
            +Guardar(p: Proveedor) void
            +GetProveedores() List~Proveedor~
            +Actualizar(p: Proveedor) void
            +Eliminar(id: int) boolean
            +ExisteNit(nit: String) boolean
        }
        class CategoriaController {
            +Guardar(c: Categoria) void
            +GetCategorias() List~Categoria~
            +Actualizar(c: Categoria) void
            +Eliminar(id: int) boolean
            +ExisteNombre(nombre: String) boolean
        }
        class ProductoController {
            +Guardar(p: Producto) void
            +GetProductos() List~Producto~
            +Actualizar(p: Producto) void
            +Eliminar(id: int) boolean
            +ExisteCodigo(codigo: String) boolean
        }
        class FacturaController {
            +Guardar(f: Factura) boolean
            +GetFacturas() List~Factura~
            +EliminarConDetalles(id: int) void
            +obtenerSiguienteNumeroFactura() String
        }
        class CompraController {
            +Guardar(c: Compra) boolean
            +GetCompras() List~Compra~
            +Anular(id: int) boolean
            +ObtenerSiguienteNumeroCompra() String
            +UltimoCosto(productoId: int) Double
        }
        class UsuarioController {
            +HayUsuarios() boolean
            +IniciarSesion(usuario: String, clave: char[]) String
            +GetUsuarios() List~Usuario~
            +Crear(usuario: String, nombre: String, clave: char[], rol: Rol) String
            +Actualizar(u: Usuario) String
            +CambiarClave(id: int, nueva: char[]) String
            +CambiarMiClave(actual: char[], nueva: char[]) String
            +Eliminar(id: int) String
        }
        class RespaldoController {
            +Respaldar(destino: File) String
        }
        class ResumenController {
            -facturas: List~Factura~
            -productos: List~Producto~
            -hoy: LocalDate
            +VentasDelDia() double
            +FacturasDelDia() int
            +VentasDelMes() double
            +VentasPorDia(dias: int) Map
            +MasVendidosDelMes(limite: int) List~ProductoVendido~
            +ExistenciaBaja(limite: int) List~Producto~
        }
        class Sesion {
            <<Singleton>>
            -usuario: Usuario
            +getInstancia()$ Sesion
            +getUsuario() Usuario
            ~iniciar(u: Usuario) void
            +cerrar() void
            +esAdministrador() boolean
        }
        class Contrasenas {
            <<utility>>
            +LONGITUD_MINIMA$: int
            +calcularHash(clave: char[])$ String
            +verificar(clave: char[], sal: String, hash: String)$ boolean
            +necesitaActualizar(hash: String)$ boolean
        }
    }

    ClienteController --> ClienteDAO
    EmpleadoController --> EmpleadoDAO
    ProveedorController --> ProveedorDAO
    CategoriaController --> CategoriaDAO
    ProductoController --> ProductoDAO
    FacturaController --> FacturaDAO
    CompraController --> CompraDAO
    CompraController ..> Sesion : usuario que registra
    UsuarioController --> UsuarioDAO
    UsuarioController ..> Contrasenas : hash bcrypt
    UsuarioController ..> Sesion : inicia sesion
    RespaldoController ..> ConexionBD
    ResumenController ..> FacturaController
    ResumenController ..> ProductoController
    Sesion --> "0..1" Usuario

    %% ================================ VISTAS ================================
    namespace vista {
        class FrmPrincipal {
            <<JFrame MDI>>
            -jDesktopPane: JDesktopPane
            -aplicarSesion() void
            -abrirFormulario(frame: JInternalFrame) void
            -respaldarBaseDatos() void
            -cerrarSesion() void
        }
        class DlgLogin {
            <<JDialog>>
            -INTENTOS_MAXIMOS$: int
            -primerUso: boolean
            +mostrar() boolean
        }
        class FrmCatalogo {
            <<abstract>>
            #modeloTabla: DefaultTableModel
            #tabla: JTable
            #agregarCampo(etiqueta: String, campo: JComponent) void
            #terminarPantalla() void
            #refrescarTabla()* void
            #cargarFila(fila: int)* void
            #guardar()* void
            #actualizar()* void
            #eliminar()* void
            #limpiarCampos()* void
        }
        class FrmCategorias
        class FrmProveedores
        class FrmUsuarios
        class FrmProductos
        class FrmClientes
        class FrmEmpleados
        class FrmFactura {
            -facturaActual: Factura
            -guardarFactura() void
            +limpiarFormulario() void
        }
        class FrmListaFacturas
        class FrmDetalleFactura
        class FrmVistaPreviaFactura {
            <<JDialog>>
        }
        class FrmCompra {
            -compraActual: Compra
            -guardarCompra() void
            -completarDatosProducto() void
        }
        class FrmListaCompras {
            -anular() void
        }
        class TicketFactura {
            +pintar(g2: Graphics2D, ancho: float) void
            +print(g: Graphics, pf: PageFormat, pagina: int) int
        }
        class Printable {
            <<interface>>
        }
        class JPanel {
            <<Swing>>
            #paintComponent(g: Graphics) void
        }
        class Tema {
            <<utility>>
            -modo: Modo
            -oscuro: boolean
            +instalar()$ void
            +setModo(modo: Modo)$ void
            +esOscuro()$ boolean
            +alCambiar(oyente: Runnable)$ void
            +serie(i: int)$ Color
        }
        class PanelTarjeta {
            #paintComponent(g: Graphics) void
        }
        class FrmResumen {
            -cargar() void
        }
        class GraficoBarrasPanel {
            +setDatos(etiquetas: List, valores: List, destacada: int) void
            #paintComponent(g: Graphics) void
        }
        class GraficoDonaPanel {
            +setDatos(valores: List, textoCentro: String, etiqueta: String) void
            #paintComponent(g: Graphics) void
        }
        class CampoBusqueda {
            -oyentes: List~ActionListener~
            -fuente: Supplier~List~String~~
            +setFuente(fuente: Supplier) void
            +addActionListener(oyente: ActionListener) void
            -notificar() void
        }
        class ReporteHtml {
            +desdeTabla(titulo: String, tabla: JTable)$ ReporteHtml
            +generarHtml() String
            +abrir(padre: Component) File
            ~escapar(texto: String)$ String
        }
        class Reportes {
            <<utility>>
            +inventario(padre: Component)$ void
            +existenciaBaja(padre: Component)$ void
            +ventasPorPeriodo(padre: Component)$ void
            +comprasPorProveedor(padre: Component)$ void
        }
        class BarraBusqueda {
            <<utility>>
            +instalar(frame: JInternalFrame, tabla: JTable, scroll: JScrollPane, titulo: String)$ void
        }
        class FiltroTabla {
            <<utility>>
            +instalar(campo: JTextField, tabla: JTable)$ void
            +filaDelModelo(tabla: JTable)$ int
        }
    }

    FrmCatalogo <|-- FrmCategorias
    FrmCatalogo <|-- FrmProveedores
    FrmCatalogo <|-- FrmUsuarios
    TicketFactura ..|> Printable
    JPanel <|-- PanelTarjeta
    FrmResumen *-- PanelTarjeta
