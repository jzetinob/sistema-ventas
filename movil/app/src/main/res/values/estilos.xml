<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Modo claro. values-night/estilos.xml define el mismo tema para el modo oscuro. -->
    <style name="TemaVentas" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/primario</item>
        <item name="android:colorPrimaryDark">@color/primario_oscuro</item>
        <item name="android:colorAccent">@color/acento</item>
        <item name="android:windowBackground">@color/fondo</item>
        <item name="android:textColorPrimary">@color/texto</item>
        <item name="android:textColorSecondary">@color/texto_suave</item>
    </style>

    <style name="BotonMenu">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">56dp</item>
        <item name="android:layout_marginBottom">12dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:backgroundTint">@color/primario</item>
        <item name="android:textColor">@color/texto_sobre_primario</item>
    </style>

    <style name="Campo">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:singleLine">true</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textColorHint">@color/texto_suave</item>
    </style>

    <!-- Tarjeta: fondo redondeado con borde y una sombra suave -->
    <style name="Tarjeta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:background">@drawable/fondo_tarjeta</item>
        <item name="android:elevation">2dp</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="TituloTarjeta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Indicador (numero grande + etiqueta) de las tarjetas del resumen.
         En Android 8+ (values-v26) el texto ademas se achica solo si no cabe. -->
    <style name="ValorIndicador">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/primario</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:maxLines">1</item>
        <item name="android:ellipsize">end</item>
    </style>

    <style name="EtiquetaIndicador">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">12sp</item>
    </style>
</resources>
