<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla de consulta con buscador: la usan Productos y Clientes -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="12dp"
    android:paddingEnd="16dp">

    <EditText
        android:id="@+id/txtBuscar"
        style="@style/Campo"
        android:background="@drawable/fondo_tarjeta"
        android:drawableStart="@drawable/ic_buscar"
        android:drawablePadding="10dp"
        android:drawableTint="@color/texto_suave"
        android:hint="@string/buscar_producto"
        android:imeOptions="actionSearch"
        android:importantForAutofill="no"
        android:inputType="text"
        android:paddingStart="12dp"
        android:paddingEnd="12dp" />

    <!-- Aviso cuando se muestran datos guardados por falta de internet -->
    <TextView
        android:id="@+id/lblAviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/fondo_tarjeta"
        android:drawableStart="@drawable/ic_sin_conexion"
        android:drawablePadding="8dp"
        android:drawableTint="@color/alerta"
        android:gravity="center_vertical"
        android:padding="10dp"
        android:textColor="@color/alerta"
        android:textSize="13sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/lblVacio"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:padding="24dp"
        android:text="@string/sin_resultados"
        android:textColor="@color/texto_suave"
        android:visibility="gone" />

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/deslizar"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/lista"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:divider="@android:color/transparent"
            android:dividerHeight="10dp"
            android:paddingBottom="16dp" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
