<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/deslizar"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Indicadores -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Tarjeta"
                    android:layout_width="0dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/lblVentasHoy"
                        style="@style/ValorIndicador" />

                    <TextView
                        style="@style/EtiquetaIndicador"
                        android:text="@string/ventas_hoy" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Tarjeta"
                    android:layout_width="0dp"
                    android:layout_marginEnd="8dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/lblFacturasHoy"
                        style="@style/ValorIndicador" />

                    <TextView
                        style="@style/EtiquetaIndicador"
                        android:text="@string/facturas_hoy" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Tarjeta"
                    android:layout_width="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:id="@+id/lblVentasMes"
                        style="@style/ValorIndicador" />

                    <TextView
                        style="@style/EtiquetaIndicador"
                        android:text="@string/ventas_mes" />
                </LinearLayout>
            </LinearLayout>

            <!-- Grafico de barras -->
            <LinearLayout
                style="@style/Tarjeta"
                android:orientation="vertical">

                <TextView
                    style="@style/TituloTarjeta"
                    android:text="@string/ventas_semana" />

                <com.josue.ventas.movil.vista.GraficoBarras
                    android:id="@+id/graficoBarras"
                    android:layout_width="match_parent"
                    android:layout_height="200dp" />
            </LinearLayout>

            <!-- Grafico de dona con su leyenda -->
            <LinearLayout
                style="@style/Tarjeta"
                android:orientation="vertical">

                <TextView
                    style="@style/TituloTarjeta"
                    android:text="@string/mas_vendidos" />

                <com.josue.ventas.movil.vista.GraficoDona
                    android:id="@+id/graficoDona"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:id="@+id/leyenda"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Productos por agotarse -->
            <LinearLayout
                style="@style/Tarjeta"
                android:orientation="vertical">

                <TextView
                    style="@style/TituloTarjeta"
                    android:text="@string/por_agotarse_titulo" />

                <LinearLayout
                    android:id="@+id/listaAgotandose"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
