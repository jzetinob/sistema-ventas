<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/deslizar"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/lblBienvenida"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/texto"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/lblRol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:textColor="@color/texto_suave" />

            <!-- Indicadores del dia: al tocarlos se abre el Resumen -->
            <LinearLayout
                android:id="@+id/filaIndicadores"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="20dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/Tarjeta"
                    android:layout_width="0dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/lblVentasHoy"
                        style="@style/ValorIndicador"
                        android:text="@string/sin_dato" />

                    <TextView
                        style="@style/EtiquetaIndicador"
                        android:text="@string/ventas_hoy" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Tarjeta"
                    android:layout_width="0dp"
                    android:layout_marginEnd="12dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/lblFacturasHoy"
                        style="@style/ValorIndicador"
                        android:text="@string/sin_dato" />

                    <TextView
                        style="@style/EtiquetaIndicador"
                        android:text="@string/facturas_hoy" />
                </LinearLayout>

                <LinearLayout
                    style="@style/Tarjeta"
                    android:layout_width="0dp"
                    android:layout_marginBottom="0dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="14dp">

                    <TextView
                        android:id="@+id/lblExistenciaBaja"
                        style="@style/ValorIndicador"
                        android:text="@string/sin_dato" />

                    <TextView
                        style="@style/EtiquetaIndicador"
                        android:text="@string/por_agotarse" />
                </LinearLayout>
            </LinearLayout>

            <!-- Botones del menu en mosaico de 2 columnas (los arma MenuActivity) -->
            <GridLayout
                android:id="@+id/mosaico"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:columnCount="2"
                android:useDefaultMargins="false" />

            <Button
                android:id="@+id/btnSalir"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="8dp"
                android:drawableStart="@drawable/ic_salir"
                android:drawablePadding="8dp"
                android:drawableTint="@color/texto_suave"
                android:text="@string/cerrar_sesion"
                android:textColor="@color/texto_suave" />
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
