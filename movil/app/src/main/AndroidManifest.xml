<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:icon="@drawable/ic_ventas"
        android:label="@string/app_name"
        android:theme="@style/TemaVentas">

        <activity
            android:name=".vista.LoginActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".vista.MenuActivity" />
        <activity android:name=".vista.ProductosActivity" android:label="@string/titulo_productos" />
        <activity android:name=".vista.ClientesActivity" android:label="@string/titulo_clientes" />
        <activity
            android:name=".vista.NuevoClienteActivity"
            android:label="@string/titulo_nuevo_cliente"
            android:windowSoftInputMode="adjustResize" />
        <activity android:name=".vista.VentasActivity" android:label="@string/titulo_ventas" />
    </application>
</manifest>
